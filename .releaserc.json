{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "breaking": true,
            "release": "major"
          }
        ]
      }
    ],

    [
      "semantic-release-jira-notes",
      {
        "jiraHost": "aventusinformatics-team-xa3a5udd.atlassian.net",
        "ticketPrefixes": ["DRNT2"],

        "preset": "conventionalcommits",

        "presetConfig": {
          "types": [
            {
              "type": "feat",
              "section": "Features"
            },
            {
              "type": "fix",
              "section": "Bug Fixes"
            },
            {
              "type": "perf",
              "section": "Performance"
            },
            {
              "type": "docs",
              "section": "Documentation"
            },
            {
              "type": "refactor",
              "section": "Refactoring"
            },
            {
              "type": "test",
              "section": "Tests"
            },
            {
              "type": "chore",
              "section": "Other Changes",
              "hidden": false
            }
          ]
        }
      }
    ],

    [
      "@open-turo/semantic-release-jira",
      {
        "jiraServerUrl": "${JIRA_SERVER_URL}",
        "jiraUsername": "${JIRA_USER_EMAIL}",
        "jiraApiToken": "${JIRA_API_TOKEN}",
        "transitionIssues": true,
        "transitionToStatus": "Released",
        "createVersions": true
      }
    ],

    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],

    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],

    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", "CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],

    "@semantic-release/github"
  ]
}
